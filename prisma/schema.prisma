// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS — STAFF
// ============================================================

enum Role {
  ADMIN_SYSTEM   // Administrador del sistema — acceso total a todos los consultorios
  MAIN_DOCTOR    // Médico principal — acceso total dentro de su(s) consultorio(s)
  DOCTOR         // Médico — solo ve sus propios pacientes y citas
  RECEPTIONIST   // Recepcionista — gestión de citas y pacientes, sin acceso al expediente clínico
  PATIENT        // PACIENTE — Usuario por defecto
}

enum ScheduleOverrideType {
  AVAILABLE                 //trabaja aunque normalmente no
  UNAVAILABLE               //no trabaja
  CUSTOM                    //horario distinto
}

// ============================================================
// ENUMS — PATIENT (Fase 2)
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  O_POSITIVE
  O_NEGATIVE
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  FREE_UNION
  OTHER
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  HIGH_SCHOOL
  TECHNICAL
  BACHELOR
  POSTGRADUATE
}

/// Hábito codificado para campos de antecedentes no patológicos.
/// Permite estadísticas y búsquedas estructuradas vs texto libre.
enum HabitStatus {
  NEVER
  FORMER    // Ex-consumidor
  CURRENT
  UNKNOWN
}

/// Categoría del archivo médico adjunto al historial del paciente.
enum MedicalFileCategory {
  LAB_RESULTS    // Resultados de laboratorio (biometría, química sanguínea, etc.)
  IMAGING        // Radiografías, ultrasonidos, TC, RM
  PRESCRIPTION   // Recetas previas (de otros médicos o consultas anteriores)
  REFERRAL       // Notas de interconsulta / referencias
  SURGERY_REPORT // Informes quirúrgicos
  PATHOLOGY      // Resultados de patología / biopsias
  OTHER
}

/// Distinguishes personal pathological conditions from family history.
enum ConditionType {
  PATHOLOGICAL /// Patient's own conditions
  FAMILY       /// Heredofamilial history
}

/// Category within pathological antecedents (maps to Historia Clínica sections).
enum ConditionCategory {
  DISEASE        /// Enfermedades previas
  SURGERY        /// Cirugías
  HOSPITALIZATION /// Hospitalizaciones
  TRAUMA         /// Traumatismos
}

/// Family member for heredofamilial entries.
enum FamilyMember {
  FATHER
  MOTHER
  SIBLINGS
  CHILDREN
  OTHER
}

/// Clinical severity of an allergic reaction.
enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

// ============================================================
// APPOINTMENT — Gestión de Citas (Fase 3)
// ============================================================

enum AppointmentType {
  IN_PERSON
  HOME_VISIT
  VIRTUAL
}

enum AppointmentStatus {
  PENDING        // Agendada vía WhatsApp/Portal, pendiente de confirmar por staff
  CONFIRMED      // Confirmada por el consultorio
  IN_PROGRESS
  COMPLETED      // El paciente ya fue atendido
  CANCELLED      // Cancelada por el paciente o el médico
  NO_SHOW        // El paciente no llegó
}

enum BookingSource {
  STAFF       // Creada desde el panel admin
  WHATSAPP    // Creada via WhatsApp Flow
  PORTAL      // Creada desde el portal web del paciente
  PHONE       // Registrada manualmente por recepción
}


// ============================================================
// ENUMS — FASE 4 / 5 (Consultas y Recetas)
// ============================================================

/// Tipo de consulta — determina qué secciones del expediente se llenan
enum ConsultationType {
  FIRST_VISIT      // Primera vez con este médico
  FOLLOW_UP        // Seguimiento de padecimiento previo
  URGENT           // Urgencia / sin cita previa
  ROUTINE          // Revisión de rutina / preventiva
  PROCEDURE        // Procedimiento (curación, inyección, etc.)
}

/// Clasificación diagnóstica en la nota médica
/// Basado en el estándar de la Nota de Evolución NOM-004-SSA3-2012
enum DiagnosisType {
  DEFINITIVE       // Diagnóstico definitivo
  PRESUMPTIVE      // Diagnóstico presuntivo / a descartar
  ASSOCIATED       // Padecimiento asociado (comorbilidad)
  COMPLICATION     // Complicación del diagnóstico principal
}

/// Estado de la receta
enum PrescriptionStatus {
  DRAFT            // En construcción, no impresa
  ISSUED           // Emitida y firmada (PDF generado)
  CANCELLED        // Anulada antes de ser entregada
}

/// Condición general del paciente al momento de la consulta
enum GeneralCondition {
  GOOD             // Buen estado general
  FAIR             // Regular
  POOR             // Malo
  CRITICAL         // Crítico
}

/// Vía de administración del medicamento
enum MedicationRoute {
  ORAL             // Vía oral (tabletas, cápsulas, jarabe)
  TOPICAL          // Vía tópica (cremas, ungüentos)
  INTRAVENOUS      // Intravenosa (IV)
  INTRAMUSCULAR    // Intramuscular (IM)
  SUBCUTANEOUS     // Subcutánea (SC)
  INHALED          // Inhalada (aerosol, nebulización)
  SUBLINGUAL       // Sublingual
  RECTAL           // Rectal (supositorios)
  OPHTHALMIC       // Oftálmica (gotas oculares)
  OTIC             // Ótica (gotas para oídos)
  NASAL            // Nasal (gotas, spray)
  OTHER            // Otra vía
}

// ============================================================
// USER — Usuario del sistema (staff: admin, médicos, recepcionistas)
// ============================================================

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique               // Correo electrónico (usado para login)
  password              String                         // Contraseña hasheada con bcrypt
  firstName             String                         // Nombre
  middleName            String?                             // Segundo Nombre Opcional
  lastNamePaternal      String                              // Apellido paterno
  lastNameMaternal      String                             // Apellido materno
  role                  Role     @default(RECEPTIONIST) // Rol en el sistema
  photoUrl              String?                        // Foto de perfil en Cloudinary (opcional, solo médicos)
  photoPublicId         String?                        // public_id en Cloudinary para eliminación
  phone                 String?                        // Teléfono personal
  isActive              Boolean  @default(true)       // Activo por defecto 
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  doctorProfile DoctorProfile?                          // Solo existe si el usuario es DOCTOR o MAIN_DOCTOR
}

// ============================================================
// DOCTOR PROFILE — Perfil médico (extensión de User para doctores)
// Contiene datos clínicos, profesionales y dirección personal.
// ============================================================

model DoctorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dirección personal (para auditoría y datos de contacto)
  address             String                        // Domicilio (calle y número)
  numHome             String                        // Nimero de casa 
  colony              String                        // Colonia 
  city                String                        // Ciudad
  state               String                        // Estado
  zipCode             String                        // Código postal

  // Datos profesionales
  specialty           String?                        // Especialidad médica (ej: "Medicina General")
  professionalLicense String                        // Cédula profesional
  university          String?                        // Universidad donde se tituló
  fullTitle           String?                        // Título completo para imprimir (ej: "Dra. Carolina Cervantes Arellano")

  // Firma digital para estampar en recetas y documentos PDF
  signatureUrl        String?                        // URL de la imagen de la firma en Cloudinary
  signaturePublicId   String?                        // public_id en Cloudinary para eliminación

  isAvailable                Boolean @default(true)
  defaultAppointmentDuration Int     @default(30)
  canManageOwnSchedule       Boolean @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Consultorios donde este médico atiende
  doctorClinics DoctorClinic[]
}

// ============================================================
// CLINIC — Consultorio
// Cada sede física (o modalidad de domicilio) es un registro aquí.
// Un mismo médico puede atender en múltiples consultorios.
// ============================================================

model Clinic {
  id                  String   @id @default(uuid())
  name                String                         // Nombre del consultorio
  slug                String   @unique               // Identificador URL amigable (ej: "clinica-norte")
  logoUrl             String?                        // URL del logo en Cloudinary
  logoPublicId        String?                        // public_id en Cloudinary para poder eliminarlo
  phone               String?                        // Teléfono del consultorio
  email               String?                        // Correo del consultorio
  address             String?                        // Dirección (calle y número)
  city                String?                        // Ciudad
  state               String?                        // Estado
  zipCode             String?                        // Código postal
  rfc                 String?                        // RFC para facturación
  professionalLicense String?                        // Cédula profesional del consultorio (si aplica)
  brandColor          String?                        // Color hex para personalizar PDFs y documentos
  isActive            Boolean  @default(true)        // Activo / inactivo
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  maxDoctors          Int      @default(1)            // Maximo de doctores por consultorio

  // Relaciones
  doctorClinics  DoctorClinic[]                      // Médicos asignados a este consultorio
  patients      PatientClinic[]
  folioSequences  FolioSequence[]

}

// ============================================================
// SCHEDULE — Horarios de atención por consultorio
// Define los días y horas en que cada consultorio atiende.
// ============================================================

model ScheduleRange {
  id             String       @id @default(uuid())
  doctorClinicId String
  doctorClinic   DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)
  weekDay        Int
  startTime      String
  endTime        String
  dateFrom        String
  dateTo          String
  isActive       Boolean    @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([doctorClinicId, dateFrom, dateTo])
  @@index([doctorClinicId, weekDay])
}

model ScheduleOverride {
  id              String   @id @default(uuid())
  doctorClinicId  String
  doctorClinic    DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)
  date            String
  startTime       String?
  endTime         String?
  type            ScheduleOverrideType
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([doctorClinicId, date])
}

// ============================================================
// DOCTOR CLINIC — Relación Médico ↔ Consultorio (many-to-many)
// Controla en qué consultorios puede operar cada médico.
// ============================================================

model DoctorClinic {
  id              String        @id @default(uuid())
  doctorProfileId String                             // FK al perfil del médico
  clinicId        String                             // FK al consultorio
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinic          Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  isPrimary       Boolean       @default(false)      // true = consultorio base/principal del médico
  isActive        Boolean       @default(true)       // Permite suspender sin eliminar la relación
  assignedAt      DateTime      @default(now())      // Fecha en que se le asignó el consultorio

  scheduleRanges ScheduleRange[]
  scheduleOverrides ScheduleOverride[]
  appointments Appointment[]
  consultations   Consultation[]
  prescriptions   Prescription[]

  @@unique([doctorProfileId, clinicId])
}

// ============================================================
// PATIENT — Ficha del paciente (datos clínicos y personales)
// ============================================================

model Patient {
  id               String         @id @default(uuid())

  // Nombre estructurado (obligatorio para documentos legales y CURP)
  firstName        String
  middleName       String?
  lastNamePaternal String
  lastNameMaternal String?

  // Datos demográficos
  birthDate        DateTime
  gender           Gender
  curp             String?        @unique
  phone            String?
  email            String?
  maritalStatus    MaritalStatus?
  occupation       String?
  educationLevel   EducationLevel?

  // Dato clínico visible en cabecera del expediente
  bloodType        BloodType?

  // Contacto de emergencia
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  account        PatientAccount?
  addresses      PatientAddress[]
  medicalHistory MedicalHistory?
  medicalFiles   PatientMedicalFile[]
  clinics        PatientClinic[]
  conditions  PatientCondition[]
  medications PatientMedication[]
  allergies   PatientAllergy[]
  appointments Appointment[]
  consultations   Consultation[]
  prescriptions   Prescription[]

}

// ============================================================
// PATIENT ACCOUNT — Credenciales para portal del paciente
// Separado de User (staff) por seguridad y arquitectura
// JWT secret propio: JWT_PATIENT_SECRET
// ============================================================

model PatientAccount {
  id        String   @id @default(uuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  email     String   @unique // El email de login puede ser diferente al email de contacto del paciente
  password  String   // bcrypt hash
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PATIENT ADDRESS — Dirección normalizada
// Mexico: usa catálogo SEPOMEX
// Extranjero: campos manuales de fallback
// ============================================================

model PatientAddress {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  country   String  @default("MX")
  isPrimary Boolean @default(false)

  // ── México (SEPOMEX) ──────────────────────────────────────
  postalCodeId   String? 
  postalCode     SepomexPostalCode? @relation(fields: [postalCodeId], references: [id])
  neighborhoodId String? //colonia
  neighborhood   SepomexNeighborhood? @relation(fields: [neighborhoodId], references: [id])
  street         String? //calle
  extNumber      String? 
  intNumber      String?


  // ── Extranjero (fallback manual) ──────────────────────────
  foreignState       String?
  foreignCity        String?
  foreignPostalCode  String?
  foreignAddressLine String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PATIENT CLINIC — Relación paciente ↔ consultorio (M:N)
// Permite historial por sede y crecimiento multi-tenant
// ============================================================

model PatientClinic {
  id         String   @id @default(uuid())
  patientId  String
  clinicId   String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([patientId, clinicId])
}

// ============================================================
// MEDICAL HISTORY — Historia clínica (1:1 con Patient)
// Se crea ÚNICAMENTE en ConsultationType.FIRST_VISIT
// NO se modifica después; las consultas posteriores crean Consultation
// ============================================================

model MedicalHistory {
  id        String  @id @default(uuid())
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // ── Remaining pathological fact ───────────────────────────
  /// Whether the patient has ever had blood transfusions.
  bloodTransfusions Boolean @default(false)

  // ── Non-pathological habits ───────────────────────────────
  smoking          HabitStatus @default(UNKNOWN)
  smokingDetail    String?
  alcoholUse       HabitStatus @default(UNKNOWN)
  alcoholDetail    String?
  drugUse          HabitStatus @default(UNKNOWN)
  drugDetail       String?
  immunizations    String?
  physicalActivity String?
  pets             Boolean     @default(false)
  tattoos          Boolean     @default(false)
  woodSmokeExposure Boolean    @default(false)

  // ── Gynecological / obstetric ─────────────────────────────
  menarche            Int?
  menstrualCycle      String?
  lastMenstrualPeriod DateTime?
  sexualActivityStart Int?
  gestations          Int?
  deliveries          Int?
  abortions           Int?
  caesareans          Int?
  contraceptiveMethod String?
  menopause           Boolean?
  mammography         String?
  cervicalCytology    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PATIENT MEDICAL FILE — Archivos del historial
// PDFs e imágenes: estudios, radiografías, recetas externas, etc.
// ============================================================

model PatientMedicalFile {
  id          String              @id @default(uuid())
  patientId   String
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  category    MedicalFileCategory @default(OTHER)
  description String?             // Texto libre: "Biometría hemática 12/04/2025"
  fileName    String              // Nombre original del archivo
  fileUrl     String              // URL pública de Cloudinary
  publicId    String              // public_id en Cloudinary para eliminación
  mimeType    String              // "application/pdf" | "image/jpeg" | "image/png"
  fileSize    Int                 // Bytes

  uploadedById String?            // userId del staff que subió el archivo (auditoría)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, category])
  @@index([patientId, createdAt])
}



// ============================================================
// ICD-10 LOCAL CATALOG
// Source: CMS.gov ICD-10-CM files (updated annually, Oct)
// Import via POST /medical-catalog/icd10/import (admin only)
// ============================================================

model Icd10Code {
  id          String  @id @default(uuid())
  /// e.g. "E11"
  code        String  @unique
  /// e.g. "Diabetes mellitus tipo 2"
  description String
  /// System grouping (e.g. "Endocrine", "Cardiovascular")
  category    String?
  /// Tracks popularity for ranking search results
  searchCount Int     @default(0)
  isActive    Boolean @default(true)

  @@index([code])
  @@index([description])
}

// ============================================================
// MEDICATION CATALOG (curated: IMSS/COFEPRIS generic list)
// Allows free-text fallback flagged as non-coded.
// CNIS = catálogo de presentaciones farmacéuticas
// ============================================================

model MedicationCatalog {
  id          String  @id @default(uuid())
  /// Sustancia activa pura para el buscador (ej. "PARACETAMOL")
  name            String  
  /// ¡NUEVA! Presentación (ej. "Tableta", "Suspensión oral")
  form            String? 
  /// ¡NUEVA! Gramaje o dosis (ej. "500 mg", "2 g / 100 ml")
  concentration   String? 
  /// Toda la descripción gubernamental junta (por si se necesita imprimir legalmente)
  description     String? @db.Text 
  /// Clave oficial del CNIS de 12 dígitos
  rxnormCode      String? @unique
  searchCount     Int     @default(0)
  isActive        Boolean @default(true)

  medications PatientMedication[]
  suggestions         IcdMedicationSuggestion[]
  prescriptionItems   PrescriptionItem[]

  @@index([name])
}

// ============================================================
// PATIENT CONDITION
// Replaces: diseases, surgeries, hospitalizations, traumaHistory (string)
// Also replaces: fatherHistory, motherHistory, etc. (via type=FAMILY)
// ============================================================

model PatientCondition {
  id        String @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// ICD-10 code (nullable: allows free-text entry)
  icd10Code   String?
  /// Human-readable name (always required; sourced from ICD-10 or free text)
  description String
  category    ConditionCategory
  type        ConditionType     @default(PATHOLOGICAL)
  /// Only set when type = FAMILY
  familyMember FamilyMember?
  /// Free-text clinical context (e.g. "20 años de evolución")
  notes       String?
  /// true when no ICD-10 match was found; flagged for later review
  isNonCoded  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId, category])
  @@index([patientId, type])
}

// ============================================================
// PATIENT MEDICATION
// Replaces: currentMedications (string)
// ============================================================

model PatientMedication {
  id        String @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// FK to catalog (null when isNonCoded = true)
  catalogId  String?
  catalog    MedicationCatalog? @relation(fields: [catalogId], references: [id])
  /// Always stored to survive catalog changes
  name       String
  dose       String?
  frequency  String?
  isNonCoded Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([patientId])
}

// ============================================================
// PATIENT ALLERGY
// Replaces: allergies (string)
// ============================================================

model PatientAllergy {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  substance String
  reaction  String?
  severity  AllergySeverity @default(UNKNOWN)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([patientId])
}

// ============================================================
// SEPOMEX — Catálogo postal oficial de México
// Fuente: Correos de México (sepomex.gob.mx)
// Actualización: cada 6-12 meses (UPSERT only, never DELETE)
// ============================================================

model SepomexState {
  id   String @id @default(uuid())
  code String @unique  // c_estado (e.g. "01")
  name String          // d_estado (e.g. "Aguascalientes")

  municipalities SepomexMunicipality[]
}

model SepomexMunicipality {
  id      String       @id @default(uuid())
  code    String                        // c_mnpio (e.g. "001")
  name    String                        // D_mnpio
  stateId String
  state   SepomexState @relation(fields: [stateId], references: [id])

  postalCodes SepomexPostalCode[]

  @@unique([code, stateId])
}

model SepomexPostalCode {
  id             String              @id @default(uuid())
  code           String                               // d_codigo (e.g. "64000")
  municipalityId String
  municipality   SepomexMunicipality @relation(fields: [municipalityId], references: [id])

  neighborhoods    SepomexNeighborhood[]
  patientAddresses PatientAddress[]

  @@index([code])
  @@unique([code, municipalityId])
}

model SepomexNeighborhood {
  id           String            @id @default(uuid())
  name         String                                // d_asenta
  type         String                                // d_tipo_asenta (e.g. "Colonia")
  zone         String?                               // d_zona (e.g. "Urbano")
  postalCodeId String
  postalCode   SepomexPostalCode @relation(fields: [postalCodeId], references: [id])

  // id_asenta_cpcons del dataset — identifica unívocamente una colonia
  // dentro de un CP para hacer UPSERT seguro en actualizaciones
  sepomexId    String?  
  patientAddresses PatientAddress[]
  @@unique([postalCodeId, sepomexId])
}


// ============================================================
// APPOINTMENT — Gestión de Citas (Fase 3)
// ============================================================


model Appointment {
  id             String            @id @default(uuid())

  // Paciente — null si es guest (agendó sin cuenta)
  patientId      String?
  patient        Patient?          @relation(fields: [patientId], references: [id])

  // Guest info — usado cuando patientId es null
  guestName      String?
  guestPhone     String?
  guestEmail     String?


  // Médico + consultorio (ya tienes DoctorClinic)
  doctorClinicId String
  doctorClinic   DoctorClinic      @relation(fields: [doctorClinicId], references: [id])

  // Tiempos en DateTime (UTC)
  // No usamos "date: String" porque startTime ya incluye la fecha.
  // Evitamos redundancia y posibles errores de sincronización.
  startTime      DateTime
  endTime        DateTime
  
  // Tipo y estado
  type           AppointmentType   @default(IN_PERSON)
  status         AppointmentStatus @default(PENDING)

  // Motivo de consulta
  reason         String?
  internalNotes  String?           // Solo visible para staff, jamás al paciente

  // Domicilio — solo cuando type = HOME_VISIT
  homeAddress    String?

  // Origen y trazabilidad
  bookedVia      BookingSource     @default(STAFF)
  waMessageId    String?           // ID del mensaje WA origen (para deduplicación)
  waPhoneNumber  String?           // Número WA desde donde agendó

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  consultation    Consultation?

  @@index([doctorClinicId, startTime])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}


// ============================================================
// CONSULTATION — Nota de Evolución / Consulta médica
//
// DECISIONES DE DISEÑO:
//   1. Separado de Appointment: Una cita puede existir sin consulta
//      (cancelada, no-show). La consulta es el acto médico real.
//   2. Campos de texto libre para los hallazgos y planes porque
//      la práctica clínica requiere narrativa, no solo datos estructurados.
//   3. consultedAt !== startTime de la cita: el médico puede llegar tarde,
//      atrasarse, o la consulta puede durar más de lo agendado.
//   4. folioNumber: secuencia CON-YYYY-NNNNNN por consultorio para auditoría.
//
// NOM-004-SSA3-2012 (Expediente Clínico):
//   - Motivo de consulta ✓ (reasonForVisit)
//   - Padecimiento actual ✓ (currentCondition)
//   - Exploración física ✓ (physicalExamFindings)
//   - Resultados de estudios ✓ (labResultsSummary)
//   - Diagnóstico ✓ (ConsultationDiagnosis)
//   - Tratamiento ✓ (treatmentPlan + Prescription)
//   - Pronóstico ✓ (prognosis)
// ============================================================

model Consultation {
  id              String   @id @default(uuid())

  // Folio único para trazabilidad y auditoría
  // Formato: CON-2025-000001 (generado en el service, no en DB)
  folioNumber     String   @unique

  // Relación con la cita que originó esta consulta (puede ser null
  // si el médico crea la consulta sin cita previa — caso urgencias)
  appointmentId   String?  @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])

  // Paciente y médico — aunque ya vienen por la cita, los desnormalizamos
  // aquí para que la consulta sea autónoma (el expediente debe funcionar
  // aunque se borre una cita)
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])

  doctorClinicId  String
  doctorClinic    DoctorClinic @relation(fields: [doctorClinicId], references: [id])

  consultationType ConsultationType @default(FOLLOW_UP)

  // ── Sección 1: Motivo de consulta y padecimiento actual ────────────────
  // NOM-004 §4.2.1 — texto libre, obligatorio
  reasonForVisit    String   @db.Text
  currentCondition  String   @db.Text  // Padecimiento actual (evolución, síntomas, etc.)

  // ── Sección 2: Exploración física ─────────────────────────────────────
  // Los signos vitales van en VitalSigns (modelo separado para tipado fuerte)
  physicalExamFindings String?  @db.Text // Hallazgos de la exploración física

  // ── Sección 3: Estudios de laboratorio e imagen ────────────────────────
  // Resumen narrativo — los archivos físicos van en PatientMedicalFile
  labResultsSummary String?  @db.Text

  // ── Sección 4: Diagnóstico ─────────────────────────────────────────────
  // Los diagnósticos van en ConsultationDiagnosis (modelo separado para ICD-10)
  clinicalImpressions String? @db.Text // Impresión clínica / notas diagnósticas

  // ── Sección 5: Tratamiento y plan ─────────────────────────────────────
  // La receta va en Prescription (modelo separado para PDF y trazabilidad)
  treatmentPlan     String?  @db.Text  // Plan de tratamiento no farmacológico
  patientInstructions String? @db.Text // Indicaciones para el paciente
  prognosis         String?  @db.Text  // Pronóstico

  // ── Seguimiento ────────────────────────────────────────────────────────
  requiresFollowUp  Boolean  @default(false)
  followUpDays      Int?     // En cuántos días debe regresar
  followUpNotes     String?  // Notas sobre el seguimiento

  // ── Metadatos ──────────────────────────────────────────────────────────
  // consultedAt es el momento real de la consulta (puede diferir de startTime)
  consultedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  vitalSigns      VitalSigns?
  diagnoses       ConsultationDiagnosis[]
  prescription    Prescription?

  @@index([patientId, consultedAt])
  @@index([doctorClinicId, consultedAt])
  @@index([folioNumber])
  @@map("consultations")
}

// ============================================================
// VITAL SIGNS — Signos Vitales
//
// DECISIONES DE DISEÑO:
//   1. Modelo separado de Consultation para poder tipar fuertemente
//      cada campo (Float, Int) en lugar de texto libre.
//   2. Relación 1:1 con Consultation — se llenaN al inicio de la consulta.
//   3. BMI se calcula y almacena (no es solo campo derivado) porque
//      el médico puede corregirlo o necesitamos histórico.
//   4. bloodPressure como String "120/80" porque el médico así lo dicta;
//      podría normalizarse a systolic/diastolic Int pero agrega complejidad
//      sin beneficio claro para el MVP.
// ============================================================

model VitalSigns {
  id              String       @id @default(uuid())
  consultationId  String       @unique
  consultation    Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  // ── Antropometría ──────────────────────────────────────────────────────
  weightKg        Float?   // Peso en kilogramos (ej: 68.5)
  heightCm        Float?   // Talla en centímetros (ej: 170.0)
  bmi             Float?   // IMC calculado (ej: 23.7) — se guarda para histórico

  // ── Signos vitales ─────────────────────────────────────────────────────
  bloodPressure   String?  // Presión arterial "sistólica/diastólica" (ej: "120/80")
  heartRateBpm    Int?     // Frecuencia cardíaca en latidos por minuto
  respiratoryRate Int?     // Frecuencia respiratoria por minuto
  temperatureC    Float?   // Temperatura corporal en Celsius (ej: 36.6)
  oxygenSaturation Int?   // Saturación de oxígeno en % (ej: 98)

  // ── Glucometría ────────────────────────────────────────────────────────
  // String porque puede ser "125 (ayunas)" o "210 (posprandial)"
  glucoseMgdl     String?

  // ── Condición general ─────────────────────────────────────────────────
  generalCondition GeneralCondition @default(GOOD)

  // ── Notas adicionales ──────────────────────────────────────────────────
  // Para observaciones que no caben en los campos anteriores
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("vital_signs")
}

// ============================================================
// CONSULTATION DIAGNOSIS — Diagnósticos de la consulta
//
// DECISIONES DE DISEÑO:
//   1. Muchos diagnósticos por consulta (principal + asociados).
//   2. Guarda una copia del description en el momento de la consulta
//      (snapshot) para que el expediente no cambie si el catálogo ICD-10
//      se actualiza en el futuro.
//   3. isMain marca el diagnóstico principal (el que va en la receta).
//   4. La relación con Icd10Code es por el código string (no UUID) porque
//      así está diseñado tu catálogo y es el estándar internacional.
// ============================================================

model ConsultationDiagnosis {
  id              String       @id @default(uuid())
  consultationId  String
  consultation    Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  // Snapshot del código y descripción al momento de la consulta
  icd10Code       String?      // Puede ser null si el médico lo escribe en texto libre
  description     String       // Siempre requerido — texto legible del diagnóstico
  diagnosisType   DiagnosisType @default(DEFINITIVE)
  isMain          Boolean      @default(false) // Solo uno puede ser true por consulta
  notes           String?      // Notas clínicas sobre este diagnóstico específico

  sortOrder       Int          @default(0) // Para ordenar diagnósticos en el expediente

  createdAt       DateTime     @default(now())

  // Un diagnóstico puede tener medicamentos sugeridos en la receta
  prescriptionItems PrescriptionItem[]

  @@index([consultationId])
  @@map("consultation_diagnoses")
}

// ============================================================
// PRESCRIPTION — Receta médica
//
// DECISIONES DE DISEÑO:
//   1. Separado de Consultation porque tiene su propio ciclo de vida
//      (puede generarse, imprimirse, anularse y regenerarse).
//   2. Snapshot completo del médico al momento de emisión para que
//      la receta sea válida legalmente aunque cambie el perfil.
//   3. pdfUrl + pdfPublicId: el PDF se guarda en Cloudinary y tiene
//      acceso por 30 días (tu Fase 5 lo indica).
//   4. expiresAt: las recetas en México tienen validez de 30 días
//      para medicamentos del cuadro básico, 6 meses para IECE.
//   5. folioNumber: secuencia REC-YYYY-NNNNNN independiente de la consulta.
// ============================================================

model Prescription {
  id              String   @id @default(uuid())

  // Folio único — formato REC-2025-000001
  folioNumber     String   @unique

  consultationId  String   @unique
  consultation    Consultation @relation(fields: [consultationId], references: [id])

  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])

  doctorClinicId  String
  doctorClinic    DoctorClinic @relation(fields: [doctorClinicId], references: [id])

  status          PrescriptionStatus @default(DRAFT)

  // ── Snapshot del médico al momento de emitir ───────────────────────────
  // CRÍTICO para validez legal: el expediente debe reflejar quién era
  // el médico al momento de la consulta, aunque luego cambie sus datos.
  doctorName      String   // Nombre completo del médico al momento de emisión
  doctorLicense   String   // Cédula profesional
  doctorSpecialty String?  // Especialidad
  clinicName      String   // Nombre del consultorio
  clinicAddress   String?  // Dirección del consultorio
  clinicPhone     String?  // Teléfono del consultorio

  // ── PDF ────────────────────────────────────────────────────────────────
  pdfUrl          String?  // URL de Cloudinary (válida 30 días desde generación)
  pdfPublicId     String?  // public_id para eliminación en Cloudinary

  // ── Validez temporal ───────────────────────────────────────────────────
  issuedAt        DateTime @default(now())
  expiresAt       DateTime // Calculado en el service (issuedAt + 30 días por default)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Medicamentos de la receta
  items           PrescriptionItem[]

  @@index([patientId, issuedAt])
  @@index([doctorClinicId, issuedAt])
  @@map("prescriptions")
}

// ============================================================
// PRESCRIPTION ITEM — Renglón de medicamento en la receta
//
// DECISIONES DE DISEÑO:
//   1. Guarda nombre del medicamento como snapshot (medicationName)
//      además del FK al catálogo, por si el catálogo cambia.
//   2. consultationDiagnosisId OPCIONAL: permite saber para qué
//      diagnóstico se prescribió cada medicamento (trazabilidad clínica)
//      pero no es obligatorio para el MVP.
//   3. sortOrder para que el médico pueda reordenar los medicamentos
//      como aparecerán en la receta impresa.
//   4. route como String (no enum) para mayor flexibilidad —
//      el médico puede escribir "V.O." o "tópico" libremente.
// ============================================================

model PrescriptionItem {
  id                  String       @id @default(uuid())
  prescriptionId      String
  prescription        Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  // FK opcional al diagnóstico que originó esta prescripción
  consultationDiagnosisId String?
  consultationDiagnosis   ConsultationDiagnosis? @relation(fields: [consultationDiagnosisId], references: [id])

  // FK al catálogo (puede ser null si el médico escribe un medicamento no catalogado)
  catalogId           String?
  catalog             MedicationCatalog? @relation(fields: [catalogId], references: [id])

  // Snapshot del medicamento — sobrevive a cambios en el catálogo
  medicationName      String       // Nombre genérico (ej: "Paracetamol")
  brandName           String?      // Nombre comercial opcional (ej: "Tylenol")

  // ── Indicaciones clínicas ──────────────────────────────────────────────
  dose                String       // (ej: "500 mg", "1 tableta")
  frequency           String       // (ej: "cada 8 horas", "tres veces al día")
  duration            String       // (ej: "7 días", "hasta terminar")
  route               String?      // (ej: "Vía oral", "Tópico")
  quantity            Int?         // Unidades a dispensar (ej: 21 tabletas)

  // Instrucciones adicionales para el paciente
  instructions        String?      // (ej: "Tomar con alimentos", "Evitar alcohol")

  // Para ordenar en la receta impresa
  sortOrder           Int          @default(0)

  createdAt           DateTime     @default(now())

  @@index([prescriptionId])
  @@map("prescription_items")
}

// ============================================================
// ICD MEDICATION SUGGESTION — Tabla de sugerencias CDS
//
// DECISIONES DE DISEÑO:
//   1. Esta es la pieza central del "autocomplete inteligente".
//      El backend la consulta cuando el médico selecciona un ICD-10
//      y retorna sugerencias ordenadas por priority y usageCount.
//   2. usageCount: se incrementa CADA VEZ que el médico acepta una
//      sugerencia en una receta real → el sistema aprende con el uso.
//   3. priority: valor inicial fijo (basado en GPC del CENETEC o criterio
//      del admin médico); usageCount lo desplaza en los resultados.
//   4. Los campos default* son puntos de partida editables, no obligatorios.
//   5. icd10Code es String (no FK con UUID) porque así está en tu schema
//      actual de Icd10Code — mantiene consistencia.
// ============================================================

model IcdMedicationSuggestion {
  id                  String   @id @default(uuid())

  // El diagnóstico
  icd10Code           String
  // No hacemos @relation aquí porque Icd10Code.code es el campo @unique
  // y Prisma requiere FK hacia el @id (uuid). Lo resolvemos en el service
  // con una consulta previa. Si en el futuro agregas codeId, se puede migrar.

  // El medicamento sugerido
  medicationCatalogId String
  medicationCatalog   MedicationCatalog @relation(fields: [medicationCatalogId], references: [id])

  // Valores por defecto — pre-llenados en la receta pero editables
  defaultDose         String?  // (ej: "500 mg")
  defaultFrequency    String?  // (ej: "cada 8 horas")
  defaultDuration     String?  // (ej: "7 días")
  defaultRoute        String?  // (ej: "Vía oral")
  defaultQuantity     Int?     // Unidades por default

  // Clasificación y aprendizaje
  priority            Int      @default(10) // Menor = más importante en la lista
  usageCount          Int      @default(0)  // Se incrementa cuando el médico acepta la sugerencia

  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([icd10Code, medicationCatalogId]) // Un medicamento por diagnóstico (sin duplicados)
  @@index([icd10Code, priority, usageCount]) // Índice compuesto para el query de sugerencias
  @@map("icd_medication_suggestions")
}

// ============================================================
// FOLIO SEQUENCE — Secuencias de folios por consultorio
//
// DECISIONES DE DISEÑO:
//   1. Separado de las consultas/recetas para poder tener secuencias
//      independientes por tipo y por consultorio.
//   2. Se usa SELECT FOR UPDATE (transacción) en el service para
//      garantizar unicidad bajo carga concurrente.
//   3. prefix + year + lastNumber → "CON-2025-000001"
//   4. Un registro por (clinicId, type, year) — se reinicia cada año.
// ============================================================

model FolioSequence {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])

  // Tipo de documento: CON = consulta, REC = receta, APT = cita (si se necesita)
  type        String   // "CON" | "REC"
  year        Int      // Año de la secuencia (se reinicia cada enero)
  lastNumber  Int      @default(0) // Último número emitido

  updatedAt   DateTime @updatedAt

  @@unique([clinicId, type, year])
  @@map("folio_sequences")
}