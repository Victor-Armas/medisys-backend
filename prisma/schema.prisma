// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS — STAFF
// ============================================================

enum Role {
  ADMIN_SYSTEM   // Administrador del sistema — acceso total a todos los consultorios
  MAIN_DOCTOR    // Médico principal — acceso total dentro de su(s) consultorio(s)
  DOCTOR         // Médico — solo ve sus propios pacientes y citas
  RECEPTIONIST   // Recepcionista — gestión de citas y pacientes, sin acceso al expediente clínico
  PATIENT        // PACIENTE — Usuario por defecto
}

enum ScheduleOverrideType {
  AVAILABLE                 //trabaja aunque normalmente no
  UNAVAILABLE               //no trabaja
  CUSTOM                    //horario distinto
}

// ============================================================
// ENUMS — PATIENT (Fase 2)
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  O_POSITIVE
  O_NEGATIVE
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  FREE_UNION
  OTHER
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY
  HIGH_SCHOOL
  TECHNICAL
  BACHELOR
  POSTGRADUATE
}

/// Hábito codificado para campos de antecedentes no patológicos.
/// Permite estadísticas y búsquedas estructuradas vs texto libre.
enum HabitStatus {
  NEVER
  FORMER    // Ex-consumidor
  CURRENT
  UNKNOWN
}

// ============================================================
// USER — Usuario del sistema (staff: admin, médicos, recepcionistas)
// ============================================================

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique               // Correo electrónico (usado para login)
  password              String                         // Contraseña hasheada con bcrypt
  firstName             String                         // Nombre
  middleName            String?                             // Segundo Nombre Opcional
  lastNamePaternal      String                              // Apellido paterno
  lastNameMaternal      String                             // Apellido materno
  role                  Role     @default(RECEPTIONIST) // Rol en el sistema
  photoUrl              String?                        // Foto de perfil en Cloudinary (opcional, solo médicos)
  photoPublicId         String?                        // public_id en Cloudinary para eliminación
  phone                 String?                        // Teléfono personal
  isActive              Boolean  @default(true)       // Activo por defecto 
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  doctorProfile DoctorProfile?                          // Solo existe si el usuario es DOCTOR o MAIN_DOCTOR
}

// ============================================================
// DOCTOR PROFILE — Perfil médico (extensión de User para doctores)
// Contiene datos clínicos, profesionales y dirección personal.
// ============================================================

model DoctorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dirección personal (para auditoría y datos de contacto)
  address             String                        // Domicilio (calle y número)
  numHome             String                        // Nimero de casa 
  colony              String                        // Colonia 
  city                String                        // Ciudad
  state               String                        // Estado
  zipCode             String                        // Código postal

  // Datos profesionales
  specialty           String?                        // Especialidad médica (ej: "Medicina General")
  professionalLicense String                        // Cédula profesional
  university          String?                        // Universidad donde se tituló
  fullTitle           String?                        // Título completo para imprimir (ej: "Dra. Carolina Cervantes Arellano")

  // Firma digital para estampar en recetas y documentos PDF
  signatureUrl        String?                        // URL de la imagen de la firma en Cloudinary
  signaturePublicId   String?                        // public_id en Cloudinary para eliminación

  isAvailable                Boolean @default(true)
  defaultAppointmentDuration Int     @default(30)
  canManageOwnSchedule       Boolean @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Consultorios donde este médico atiende
  doctorClinics DoctorClinic[]
}

// ============================================================
// CLINIC — Consultorio
// Cada sede física (o modalidad de domicilio) es un registro aquí.
// Un mismo médico puede atender en múltiples consultorios.
// ============================================================

model Clinic {
  id                  String   @id @default(uuid())
  name                String                         // Nombre del consultorio
  slug                String   @unique               // Identificador URL amigable (ej: "clinica-norte")
  logoUrl             String?                        // URL del logo en Cloudinary
  logoPublicId        String?                        // public_id en Cloudinary para poder eliminarlo
  phone               String?                        // Teléfono del consultorio
  email               String?                        // Correo del consultorio
  address             String?                        // Dirección (calle y número)
  city                String?                        // Ciudad
  state               String?                        // Estado
  zipCode             String?                        // Código postal
  rfc                 String?                        // RFC para facturación
  professionalLicense String?                        // Cédula profesional del consultorio (si aplica)
  brandColor          String?                        // Color hex para personalizar PDFs y documentos
  isActive            Boolean  @default(true)        // Activo / inactivo
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  maxDoctors          Int      @default(1)            // Maximo de doctores por consultorio

  // Relaciones
  doctorClinics  DoctorClinic[]                      // Médicos asignados a este consultorio
  patients      PatientClinic[]

}

// ============================================================
// SCHEDULE — Horarios de atención por consultorio
// Define los días y horas en que cada consultorio atiende.
// ============================================================

model ScheduleRange {
  id             String       @id @default(uuid())
  doctorClinicId String
  doctorClinic   DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)
  weekDay        Int
  startTime      String
  endTime        String
  dateFrom        String
  dateTo          String
  isActive       Boolean      @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([doctorClinicId, dateFrom, dateTo])
  @@index([doctorClinicId, weekDay])
}

model ScheduleOverride {
  id              String   @id @default(uuid())
  doctorClinicId  String
  doctorClinic    DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)
  date            String
  startTime       String?
  endTime         String?
  type            ScheduleOverrideType
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([doctorClinicId, date])
}

// ============================================================
// DOCTOR CLINIC — Relación Médico ↔ Consultorio (many-to-many)
// Controla en qué consultorios puede operar cada médico.
// ============================================================

model DoctorClinic {
  id              String        @id @default(uuid())
  doctorProfileId String                             // FK al perfil del médico
  clinicId        String                             // FK al consultorio
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinic          Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  isPrimary       Boolean       @default(false)      // true = consultorio base/principal del médico
  isActive        Boolean       @default(true)       // Permite suspender sin eliminar la relación
  assignedAt      DateTime      @default(now())      // Fecha en que se le asignó el consultorio

  scheduleRanges ScheduleRange[]
  scheduleOverrides ScheduleOverride[]

  @@unique([doctorProfileId, clinicId])
}

// ============================================================
// PATIENT — Ficha del paciente (datos clínicos y personales)
// ============================================================

model Patient {
  id               String         @id @default(uuid())

  // Nombre estructurado (obligatorio para documentos legales y CURP)
  firstName        String
  middleName       String?
  lastNamePaternal String
  lastNameMaternal String?

  // Datos demográficos
  birthDate        DateTime
  gender           Gender
  curp             String?        @unique
  phone            String?
  email            String?
  maritalStatus    MaritalStatus?
  occupation       String?
  educationLevel   EducationLevel?

  // Dato clínico visible en cabecera del expediente
  bloodType        BloodType?

  // Contacto de emergencia
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  account        PatientAccount?
  addresses      PatientAddress[]
  medicalHistory MedicalHistory?
  clinics        PatientClinic[]
  // Fases siguientes:
  // consultations Consultation[]
  // prescriptions Prescription[]
}

// ============================================================
// PATIENT ACCOUNT — Credenciales para portal del paciente
// Separado de User (staff) por seguridad y arquitectura
// JWT secret propio: JWT_PATIENT_SECRET
// ============================================================

model PatientAccount {
  id        String   @id @default(uuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // El email de login puede ser diferente al email de contacto del paciente
  email     String   @unique
  password  String   // bcrypt hash

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PATIENT ADDRESS — Dirección normalizada
// Mexico: usa catálogo SEPOMEX
// Extranjero: campos manuales de fallback
// ============================================================

model PatientAddress {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  country   String  @default("MX")
  isPrimary Boolean @default(false)

  // ── México (SEPOMEX) ──────────────────────────────────────
  postalCodeId   String? 
  postalCode     SepomexPostalCode? @relation(fields: [postalCodeId], references: [id])
  neighborhoodId String? //colonia
  neighborhood   SepomexNeighborhood? @relation(fields: [neighborhoodId], references: [id])
  street         String? //calle
  extNumber      String? 
  intNumber      String?


  // ── Extranjero (fallback manual) ──────────────────────────
  foreignState       String?
  foreignCity        String?
  foreignPostalCode  String?
  foreignAddressLine String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PATIENT CLINIC — Relación paciente ↔ consultorio (M:N)
// Permite historial por sede y crecimiento multi-tenant
// ============================================================

model PatientClinic {
  id         String   @id @default(uuid())
  patientId  String
  clinicId   String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([patientId, clinicId])
}

// ============================================================
// MEDICAL HISTORY — Historia clínica (1:1 con Patient)
// Se crea ÚNICAMENTE en ConsultationType.FIRST_VISIT
// NO se modifica después; las consultas posteriores crean Consultation
// ============================================================

model MedicalHistory {
  id        String  @id @default(uuid())
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // ── Antecedentes patológicos ──────────────────────────────
  diseases           String?   // Enfermedades previas (texto clínico)
  surgeries          String?
  hospitalizations   String?
  bloodTransfusions  Boolean   @default(false)
  traumaHistory      String?
  currentMedications String?   // Lista de medicamentos actuales
  allergies          String?   // Alergias conocidas

  // ── Antecedentes no patológicos ───────────────────────────
  smoking          HabitStatus  @default(UNKNOWN)
  smokingDetail    String?       // Cantidad/años si CURRENT o FORMER
  alcoholUse       HabitStatus  @default(UNKNOWN)
  alcoholDetail    String?
  drugUse          HabitStatus  @default(UNKNOWN)
  drugDetail       String?
  immunizations    String?
  physicalActivity String?
  pets             Boolean      @default(false)
  tattoos          Boolean      @default(false)
  woodSmokeExposure Boolean     @default(false)

  // ── Antecedentes heredofamiliares ─────────────────────────
  fatherHistory      String?
  motherHistory      String?
  childrenHistory    String?
  siblingsHistory    String?
  otherFamilyHistory String?

  // ── Antecedentes gineco-obstétricos ───────────────────────
  // Nullable — solo aplican según el paciente
  menarche            Int?       // Edad de primera menstruación
  menstrualCycle      String?    // Descripción del ciclo
  lastMenstrualPeriod DateTime?
  sexualActivityStart Int?       // Edad inicio actividad sexual
  gestations          Int?
  deliveries          Int?
  abortions           Int?
  caesareans          Int?
  contraceptiveMethod String?
  menopause           Boolean?
  mammography         String?    // Fecha/resultado último estudio
  cervicalCytology    String?    // Fecha/resultado último Papanicolau

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// SEPOMEX — Catálogo postal oficial de México
// Fuente: Correos de México (sepomex.gob.mx)
// Actualización: cada 6-12 meses (UPSERT only, never DELETE)
// ============================================================

model SepomexState {
  id   String @id @default(uuid())
  code String @unique  // c_estado (e.g. "01")
  name String          // d_estado (e.g. "Aguascalientes")

  municipalities SepomexMunicipality[]
}

model SepomexMunicipality {
  id      String       @id @default(uuid())
  code    String                        // c_mnpio (e.g. "001")
  name    String                        // D_mnpio
  stateId String
  state   SepomexState @relation(fields: [stateId], references: [id])

  postalCodes SepomexPostalCode[]

  @@unique([code, stateId])
}

model SepomexPostalCode {
  id             String              @id @default(uuid())
  code           String                               // d_codigo (e.g. "64000")
  municipalityId String
  municipality   SepomexMunicipality @relation(fields: [municipalityId], references: [id])

  neighborhoods    SepomexNeighborhood[]
  patientAddresses PatientAddress[]

  @@index([code])
  @@unique([code, municipalityId])
}

model SepomexNeighborhood {
  id           String            @id @default(uuid())
  name         String                                // d_asenta
  type         String                                // d_tipo_asenta (e.g. "Colonia")
  zone         String?                               // d_zona (e.g. "Urbano")
  postalCodeId String
  postalCode   SepomexPostalCode @relation(fields: [postalCodeId], references: [id])

  // id_asenta_cpcons del dataset — identifica unívocamente una colonia
  // dentro de un CP para hacer UPSERT seguro en actualizaciones
  sepomexId    String?  
  patientAddresses PatientAddress[]
  @@unique([postalCodeId, sepomexId])
}
